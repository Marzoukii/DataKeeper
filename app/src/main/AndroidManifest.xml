<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Facultative : affiche 4G ou 5G à côté de l'opérateur des données mobiles. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Onglet Wi-Fi gratuits : Android exige la localisation précise pour lister les Wi-Fi autour
         et lire le nom du Wi-Fi rejoint. Rien n'est enregistré ni envoyé. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <!-- La téléphonie reste facultative : l'appli s'installe aussi sur les tablettes sans SIM. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Accordée manuellement par l'utilisateur dans "Accès aux données d'utilisation". -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ : rend visibles les applis lançables, pour afficher le nom et l'icône
         des applis les plus gourmandes en data mobile. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Pas de publicité : retire les permissions d'identifiant publicitaire ajoutées par Firebase Analytics. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />

    <application
        android:name=".DataKeeperApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DataKeeper">
        <!-- configChanges : changer de langue ne recrée pas l'activité (sinon écran noir un instant),
             Compose se recompose dans la nouvelle langue. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DataKeeper"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widgets de l'écran d'accueil (Glance). -->
        <receiver
            android:name=".presentation.widget.QuotaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quota_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quota_info" />
        </receiver>
        <receiver
            android:name=".presentation.widget.SavingsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_savings_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_savings_info" />
        </receiver>
        <receiver
            android:name=".presentation.widget.QuotaBarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quota_bar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quota_bar_info" />
        </receiver>

        <!-- Tuiles des réglages rapides. -->
        <service
            android:name=".presentation.tile.QuotaTileService"
            android:exported="true"
            android:icon="@drawable/ic_cell"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".presentation.tile.DownloadsTileService"
            android:exported="true"
            android:icon="@drawable/ic_download"
            android:label="@string/tab_downloads"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Avant Android 13, AppCompat mémorise ici la langue choisie dans l'appli. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- WorkManager est configuré par DataKeeperApplication (HiltWorkerFactory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Pas de publicité : Firebase Analytics ne collecte ni l'identifiant publicitaire
             ni de signaux de personnalisation des annonces. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
    </application>

</manifest>
