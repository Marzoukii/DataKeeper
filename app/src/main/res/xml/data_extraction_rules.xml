<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ : rien n'est sauvegardé ni transféré vers un nouveau téléphone. Le forfait, le solde
   et le cycle valent pour une SIM et un moment donnés : restaurés après une réinstallation, ils
   sautaient l'écran du forfait et affichaient un tableau de bord faux.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
